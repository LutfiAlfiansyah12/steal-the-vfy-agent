{
  "name": "steal-the-vfy-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.0.0 <25" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --disable-proto=throw --env-file-if-exists=.env dist/src/main.js",
    "test": "npm run build && node --test --test-concurrency=1 dist/tests/*.test.js",
    "artifacts:download": "node scripts/download-artifacts.mjs",
    "artifacts:check": "node dist/scripts/check-artifacts.js",
    "commitment": "node --env-file-if-exists=.env dist/scripts/commitment.js",
    "replay": "node dist/scripts/replay.js",
    "test:proof": "node --env-file-if-exists=.env dist/scripts/proof-smoke.js"
  },
  "dependencies": {
    "circomlibjs": "0.1.7",
    "snarkjs": "0.7.6",
    "viem": "2.38.5",
    "zod": "4.6.7"
  },
  "overrides": {
    "ws": "8.21.0",
    "jsonpath@1.3.0": {
      "underscore": "1.13.8"
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
