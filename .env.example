# Copy to .env locally. Never commit .env or paste secrets into an AI tool.
# Platform Dashboard -> Rotate Secret. Use the plaintext exactly, with no hex decoding.
AGENT_GAMES_HMAC_SECRET=

# local returns locally verified proofs for offline platform verification.
# finalized additionally waits for Kurier and requires a sufficient turn deadline.
PROOF_VERIFICATION_MODE=local
# Optional in local mode; obtain a Volta testnet key for finalized mode.
KURIER_API_KEY=
ZKVERIFY_NETWORK=volta
ALLOW_COMPETITION=false

# TODO(owner): choose privately; see docs/CIRCUIT.md for verified slot meanings.
# JSON array of exactly eight decimal/0x field-element STRINGS, in circuit order.
# No example strategy is provided. Slots 4..7 are protocol-reserved and must be zero.
STRATEGY_PARAMS_JSON=
STRATEGY_SALT=

# This implementation uses Kurier and never reads a wallet key.
# If you later implement zkVerifyJS, keep its wallet key in an environment variable only.
ZKVERIFY_WALLET_KEY=

HOST=127.0.0.1
PORT=3000
ARTIFACT_DIRECTORY=artifacts
DATA_DIRECTORY=runtime
# Event page says ~30 seconds per push; leave time for network delivery.
MAX_TURN_MS=25000
RESPONSE_RESERVE_MS=1500
MAX_CONCURRENT_PROOFS=1

# Public DNS name for Caddy on the VPS. Leave blank until deploying.
AGENT_DOMAIN=
